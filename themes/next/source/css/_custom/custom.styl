/* Flashcards Styles */
.flashcard-btn {
  margin-left: 5px;
  color: #b3b3b3;
  font-weight: bold;
  font-size: 12px;
  cursor: pointer;
  transition: color 0.3s ease;
}

.flashcard-btn:hover {
  color: var(--text-color);
}

.flashcard-modal {
  display: flex;
  justify-content: center;
  align-items: flex-start; // Align to top to allow scrolling if content overflows
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.85);
  z-index: 3000;
  overflow-y: auto; // Allow modal itself to scroll if container is too tall
  padding-top: 5vh; // Add some top padding
  padding-bottom: 5vh;
}
