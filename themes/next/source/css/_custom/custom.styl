    padding: 15px;
  }
  .flashcard-back-btn {
    top: 5px; left: 5px; // Closer to edge with smaller padding
    padding: 6px 10px;
    font-size: 12px;
  }
  .close-flashcard {
    top: 5px; right: 5px;
  }
  // ... (other responsive styles)
}
