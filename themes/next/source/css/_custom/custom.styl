/* Flashcard View */
#flashcard-view {
  // width: 100%; // Handled by .fc-view
  // display: flex; // Handled by .fc-view
  // flex-direction: column; // Handled by .fc-view
  // height: 100%; // Handled by .fc-view
}

.flashcard-back-btn {
  position: absolute;
  top: 10px; // Adjusted for view's internal padding
  left: 10px; // Adjusted for view's internal padding
  // ... (rest of back button styles same)
  background-color: var(--toc-link-color);
  color: var(--selection-color);
  border: none;
  padding: 8px 12px;
  border-radius: 20px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition: background-color 0.3s;
  z-index: 10;
  display: flex;
  align-items: center;
}
.flashcard-back-btn i { margin-right: 6px; }
.flashcard-back-btn:hover { background-color: var(--link-hover-color); }


.flashcard-content-area {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  margin-top: 40px; // Increased space for back button + H1 title
}
.flashcard-current-h1-title {
  text-align: center;
  font-size: 0.9em;
  color: var(--text-color);
  margin-bottom: 10px;
  font-style: italic;
  height: 20px;
  flex-shrink: 0;
}

.flashcard {
  // ... (styles for .flashcard, .flashcard-front, .flashcard-back remain largely the same)
  // Ensure min-height is appropriate if flex-grow is used
  width: 100%;
  flex-grow: 1;
  perspective: 1000px;
  cursor: pointer;
  // margin-top: 5px; // Removed, handled by parent flex
  position: relative;
  min-height: 200px;
  transition: transform 0.15s cubic-bezier(0.15, 0.8, 0.25, 1), opacity 0.15s ease; // animationDuration
}
// ... (.is-sliding-no-transition, .slide-out-left, .slide-out-right)

.flashcard-front, .flashcard-back {
  // ... (styles remain largely the same)
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  transition: transform 0.7s;
  overflow-y: auto;
  border-radius: 0.8rem;
  box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  padding: 25px;
  box-sizing: border-box;
  background-color: var(--content-bg-color);
  color: var(--text-color);
}
// ... (.flashcard-front h2, .flashcard-back content, .flipped states)


.flashcard-navigation {
  // ... (styles remain largely the same)
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  margin-top: 15px; // Slightly reduced
  padding: 10px 0;
  width: 100%;
  flex-shrink: 0;
}

.flashcard-nav-btn {
  // ... (styles remain largely the same)
  background-color: var(--toc-link-color);
  color: var(--selection-color);
  border: none;
  padding: 10px 15px;
  border-radius: 2rem;
  cursor: pointer;
  font-size: 14px;
  font-weight: 900;
  transition: background-color 0.3s, transform 0.1s, border 0.3s, box-shadow 0.3s; // Added border/shadow
  min-width: 40px;
  text-align: center;
}
.flashcard-nav-btn:hover:not(:disabled) {
  background-color: var(--link-hover-color);
  transform: translateY(-1px);
}
.flashcard-nav-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.flashcard-nav-btn i { font-size: 1.1em; }

/* Shuffle button active state */
.flashcard-nav-btn.shuffle-active {
  background-color: var(--brand-color); // Use a theme brand color
  color: var(--sidebar-background-color); // Contrasting text color
  box-shadow: inset 0 0 0 2px var(--sidebar-highlight); // Inner border effect
}
.flashcard-nav-btn.shuffle-active:hover:not(:disabled) {
  background-color: var(--brand-hover-color);
}


// ... (.card-counter-container, .flashcard-jump-input, #card-counter-total styles remain largely the same)

.close-flashcard {
  position: absolute;
  top: 10px; // Adjusted for view's internal padding
  right: 10px; // Adjusted for view's internal padding
  // ... (rest of close button styles same)
  width: 32px;
  height: 32px;
  font-size: 18px;
  color: var(--selection-color);
  background-color: var(--link-color);
  border-radius: 50%;
  cursor: pointer;
  z-index: 10000; // Above fc-view content
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  transition: background-color 0.3s, transform 0.2s;
  border: none;
  outline: none;
}
.close-flashcard:hover {
  background-color: #ff3547;
  transform: scale(1.1);
}

/* Responsive adjustments */
// ... (Your existing responsive adjustments should still largely apply,
//      but test them with the new absolute positioned views)
@media (max-width: 768px) {
  .flashcard-container {
    width: 95%;
    // padding: 15px; // Padding is now on .fc-view
    // margin-top: 2vh; // Handled by modal
    // margin-bottom: 2vh; // Handled by modal
    // max-height: 96vh; // Handled by modal
  }
