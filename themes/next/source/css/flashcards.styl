  width: 100%;
  flex-shrink: 0;
}

.flashcard-nav-btn {
  display: flex;
  justify-content: center; /* 水平居中 */
  align-items: center;     /* 垂直居中 */
  text-align: center;
  background-color: var(--toc-link-color);
  color: var(--selection-color);
  border: none;
  padding: 10px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 14px;
  font-weight: 900;
  transition: background-color 0.3s, transform 0.1s, border 0.3s, box-shadow 0.3s;
  width: 40px;
  height: 40px;
}

.flashcard-nav-btn {
  display: flex;
  justify-content: center; /* 水平居中 */
  align-items: center;     /* 垂直居中 */
  text-align: center;
  background-color: var(--toc-link-color);
  color: var(--selection-color);
  border: none;
  padding: 10px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 14px;
  font-weight: 900;
  transition: background-color 0.3s, transform 0.1s, border 0.3s, box-shadow 0.3s;
  width: 40px;
  height: 40px;
}
.flashcard-nav-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.flashcard-nav-btn i { font-size: 1.1em; }

/* Shuffle button active state */
.flashcard-nav-btn.shuffle-active {
  background-color: var(--link-hover-color);
  //color: var(--sidebar-background-color); // Contrasting text color
  //box-shadow: inset 0 0 0 2px var(--sidebar-highlight); // Inner border effect
}

.flashcard-nav-btn.auto-read-active {
  background-color: var(--link-hover-color);
}

@media (hover: hover) and (pointer: fine) {  // disable the :hover effect on mobile devices
  .flashcard-nav-btn:hover:not(:disabled) {
    background-color: var(--link-hover-color);
    transform: translateY(-2px);
  }

  .flashcard-nav-btn.shuffle-active:hover:not(:disabled) {
    background-color: var(--link-hover-color);
  }

  .flashcard-nav-btn.auto-read-active:hover:not(:disabled) {
    background-color: var(--link-hover-color);
  }
}

// :active applies only while the button is pressed/touched.
.flashcard-nav-btn:active:not(:disabled) {
  background-color: var(--link-hover-color);
  transform: translateY(-2px);
}

.flashcard-nav-btn.shuffle-active:active:not(:disabled) {
  background-color: var(--link-hover-color);
}

.flashcard-nav-btn.auto-read-active:active:not(:disabled) {
  background-color: var(--link-hover-color);
}

.close-flashcard {
  position: absolute;
  top: 10px; // Adjusted for view's internal padding
  right: 10px; // Adjusted for view's internal padding
  // ... (rest of close button styles same)
  width: 32px;
  height: 32px;
  font-size: 18px;
  color: var(--selection-color);
  background-color: var(--link-color);
  border-radius: 50%;
  cursor: pointer;
  z-index: 10000; // Above fc-view content
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  transition: background-color 0.3s, transform 0.2s;
  border: none;
  outline: none;
}
.close-flashcard:hover {
  background-color: #ff3547;
  transform: scale(1.1);
}

