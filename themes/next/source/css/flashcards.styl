
/* Flashcards Styles */
.flashcard-btn {
  margin-left: 5px;
  color: #b3b3b3;
  font-weight: bold;
  font-size: 11px;
  cursor: pointer;
  transition: color 0.3s ease;
}

.flashcard-btn:hover {
  color: var(--text-color);
}

.flashcard-modal {
  display: flex;
  justify-content: center;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.85);
  z-index: 3000;
  overflow-y: auto; // Allow modal itself to scroll if container is too tall
  padding-top: 5vh; // Add some top padding
  padding-bottom: 5vh;
}

.flashcard-container {
  position: relative;
  width: 80%;
  height: 70%;
  max-width: 900px;
  min-height: 450px; // Adjusted min-height
  max-height: 90vh;
  background-color: var(--body-bg-color);
  border-radius: 1rem;
  box-shadow: 0 0 25px rgba(0,0,0,0.4);
  padding: 25px; // This padding defines the boundary for absolute positioned views
  display: flex; // Keep this for overall container structure if needed, but views are absolute
  flex-direction: column;
  overflow: hidden; // Crucial for containing absolute positioned views during transition
}

.flashcard.is-sliding-no-transition {
  transition: none !important;
}
.flashcard.slide-out-left {
  transform: translateX(-100%);
  opacity: 0;
}
.flashcard.slide-out-right {
  transform: translateX(100%);
  opacity: 0;
}

.flashcard-front {
  display: flex;
  flex-direction: column; /* Changed to column to allow positioning of title and icon */
  align-items: center;
  justify-content: center; /* This will center the h2 title vertically */
  text-align: center;
  position: relative; /* Needed for absolute positioning of the hint icon */
  /* Ensure padding is still applied if it was here before, or on .flashcard-front, .flashcard- */
}

.flashcard-front h2 {
  margin: 0;
  font-size: 1.8em;
  color: var(--bold-text-color);
  /* If you want the h2 to take up most space and hint icon at bottom,
     you might need to adjust flex properties or use margin-bottom on h2 */
}

.flashcard-hint-icon {
  position: absolute;
  bottom: 20px;
  left: 40px;
  font-size: 2em;
  color: var(--text-color);
  opacity: 0.7; /* Slightly transparent to be less obtrusive */
  cursor: help;
  padding: 0 2px;
}

.flashcard-hint-icon:hover {
  opacity: 1;
}

.flashcard-back {
  transform: rotateY(180deg);
  // Ensure back content styling is good
}
.flashcard-back p, .flashcard-back div, .flashcard-back ul, .flashcard-back ol, .flashcard-back pre {
  margin-bottom: 1em;
}
.flashcard-back h1, .flashcard-back h2, .flashcard-back h3, .flashcard-back h4, .flashcard-back h5, .flashcard-back h6 {
  margin-top: 1em;
  margin-bottom: 0.5em;
  color: var(--bold-text-color);
}
.flashcard-back pre {
  white-space: pre-wrap;
  word-wrap: break-word;
  background-color: var(--body-bg-color); // Different background for code blocks
  padding: 10px;
  border-radius: 5px;
}


.flashcard.flipped .flashcard-front {
  transform: rotateY(180deg);
}
.flashcard.flipped .flashcard-back {
  transform: rotateY(0);
}

.card-counter-container {
  display: flex;
  align-items: center;
  font-size: 16px;
  //font-family: monospace;
  color: var(--text-color);
  // width: 120px; // Increased width for input
  text-align: center;
}

.flashcard-jump-input {
  width: 35px; // Width for number input
  padding: 6px 8px;
  margin-right: 8px;
  border: 1px solid var(--table-border-color);
  border-radius: 8px;
  text-align: center;
  //font-family: monospace;
  font-size: 12px;
  background-color: var(--content-bg-color);
  color: var(--text-color);
  -moz-appearance: textfield; // Hide spinners in Firefox
}
.flashcard-jump-input::-webkit-outer-spin-button,
.flashcard-jump-input::-webkit-inner-spin-button {
  -webkit-appearance: none; // Hide spinners in Chrome/Safari
  margin: 0;
}

#card-counter-total {
  min-width: 40px; // Ensure space for "/ XX"
}

/* View common styles and transitions */
.fc-view { // Common class for #h1-selection-view and #flashcard-view
  position: absolute;
  top: 25px; bottom: 25px; left: 25px; right: 25px; // Fill padding area of parent
  // If .flashcard-container has display:flex, then top/left/width/height 100% is better
  // For now, assuming padding on container is the boundary
  // width: calc(100% - 50px); // 100% of parent minus parent's L/R padding
  // height: calc(100% - 50px); // 100% of parent minus parent's T/B padding
  // top: 25px; left: 25px; // Offset by parent's padding

  // Simpler: let views be 100% of .flashcard-container and handle their own internal padding
  width: 100%;
  height: 100%;
  top: 0; left: 0;
  padding: 20px; // Internal padding for each view
  box-sizing: border-box;

  display: flex; // Both views will be flex containers for their content
  flex-direction: column;

  opacity: 1;
  transform: translateX(0);
  transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out; // animationViewDuration
}

.fc-view.view-hidden {
  display: none !important;
  opacity: 0;
}

.fc-view.view-prep-left {
  transform: translateX(-100%);
  opacity: 0;
  display: flex !important;
}
.fc-view.view-prep-right {
  transform: translateX(100%);
  opacity: 0;
  display: flex !important;
}
.fc-view.view-active { // This class mainly signifies it IS active, display is handled by removing view-hidden
  transform: translateX(0%);
  opacity: 1;
  display: flex !important;
}
.fc-view.view-sliding-out-left {
  transform: translateX(-100%);
  opacity: 0;
}
.fc-view.view-sliding-out-right {
  transform: translateX(100%);
  opacity: 0;
}


