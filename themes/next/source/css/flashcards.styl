}
//.flashcard-back-btn i { margin-right: 6px; }
.flashcard-back-btn:hover { background-color: var(--link-hover-color); }


.flashcard-content-area {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  //margin-top: 40px; // Increased space for back button + H1 title
}
.flashcard-current-h1-title {
  text-align: center;
  font-size: 1em;
  color: var(--text-color);
  margin-bottom: 10px;
  padding: 0 50px;
  //font-family: math;
  //height: 20px;
  flex-shrink: 0;
  font-weight: 500;
}

.flashcard {
  // ... (styles for .flashcard, .flashcard-front, .flashcard-back remain largely the same)
  // Ensure min-height is appropriate if flex-grow is used
  width: 100%;
  flex-grow: 1;
  perspective: 1000px;
  cursor: pointer;
  // margin-top: 5px; // Removed, handled by parent flex
  position: relative;
  min-height: 200px;
  transition: transform 0.15s cubic-bezier(0.15, 0.8, 0.25, 1), opacity 0.15s ease; // animationDuration
}
// ... (.is-sliding-no-transition, .slide-out-left, .slide-out-right)

.flashcard-front, .flashcard-back {
  // ... (styles remain largely the same)
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  transition: transform 0.7s;
  overflow-y: auto;
  border-radius: 0.8rem;
  box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  padding: 25px;
  box-sizing: border-box;
  background-color: var(--content-bg-color);
  color: var(--text-color);
}
// ... (.flashcard-front h2, .flashcard-back content, .flipped states)


